rules_version = '2';

// Reglas de seguridad de Plannit Studio
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }

    // Perfil del usuario que hace la petición (rol y negocio si es decorador)
    function miPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Cada usuario solo puede leer y escribir su propio perfil
    match /usuarios/{uid} {
      allow read, create, update: if conSesion() && request.auth.uid == uid;
    }

    match /solicitudes/{id} {
      // El cliente solo crea solicitudes a su nombre y siempre empiezan como "enviada"
      allow create: if conSesion()
        && request.resource.data.clienteUid == request.auth.uid
        && request.resource.data.estado == 'enviada';

      // La ve el cliente que la hizo o el decorador al que va dirigida
      allow read: if conSesion()
        && (resource.data.clienteUid == request.auth.uid
            || miPerfil().decorador == resource.data.decorador);

      // Solo el decorador cambia el estado, y no puede tocar ningún otro campo
      allow update: if conSesion()
        && miPerfil().rol == 'decorador'
        && miPerfil().decorador == resource.data.decorador
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
        && request.resource.data.estado in ['enRevision', 'aprobada'];
    }
  }
}
